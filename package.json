{
  "name": "chimaera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verdance \u2014 a genetics-first creature breeding game.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "sim": "tsx packages/genetics/tools/simulate.ts",
    "gallery": "tsc -b && tsx packages/rendering/tools/gallery.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}
